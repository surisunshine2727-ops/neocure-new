{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false
      },
      ".read": "auth != null && root.child('admins').child(auth.uid).val() == true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
    },
    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() == true",
      ".write": false,
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() == true",
        "role": {
          ".write": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)",
          ".validate": "newData.val() == 'dealer' || root.child('admins').child(auth.uid).val() == true"
        },
        "phone": {
          ".write": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)",
          ".validate": "root.child('admins').child(auth.uid).val() == true || (!data.exists() && newData.isString() && newData.val().matches(/^\\d{10,15}$/))"
        },
        "creditLimit": {
          ".write": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)"
        },
        "profile": {
          ".write": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)"
        },
        "createdAt": {
          ".write": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)"
        },
        "updatedAt": {
          ".write": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)"
        },
        "approved": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
        },
        "status": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
        },
        "reviewedAt": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
        }
      }
    },
    "appData": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() == true",
      ".write": false,
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)",
        ".write": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)"
      }
    },
    "adminFcmTokens": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid && root.child('admins').child(auth.uid).val() == true",
        ".write": "auth != null && auth.uid == $uid && root.child('admins').child(auth.uid).val() == true"
      }
    },
    "dealerFcmTokens": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "dealer_ledger": {
      "$phone": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).val() == true || root.child('users').child(auth.uid).child('phone').val() == $phone)",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() == true || root.child('users').child(auth.uid).child('phone').val() == $phone)"
      }
    },
    "coupons": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() == true",
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
      }
    }
  }
}