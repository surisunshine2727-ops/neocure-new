{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false
      },
      ".read": "auth != null && root.child('admins').child(auth.uid).val() == true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
    },
    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() == true",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)",
        ".write": false,
        "role": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() == true || (auth.uid == $uid && !data.exists()))",
          ".validate": "newData.val() == 'dealer' || newData.val() == 'worker'"
        },
        "phone": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() == true || (auth.uid == $uid && !data.exists()))",
          ".validate": "newData.isString() && newData.val().matches(/^\\d{10}$/)"
        },
        "approved": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() == true || (auth.uid == $uid && !data.exists() && ((root.child('users').child($uid).child('role').val() == 'worker' && newData.val() == true) || (root.child('users').child($uid).child('role').val() == 'dealer' && newData.val() == false))))",
          ".validate": "newData.isBoolean()"
        },
        "status": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() == true || (auth.uid == $uid && !data.exists() && ((root.child('users').child($uid).child('role').val() == 'worker' && newData.val() == 'active') || (root.child('users').child($uid).child('role').val() == 'dealer' && newData.val() == 'pending'))))",
          ".validate": "newData.isString()"
        },
        "createdAt": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() == true || (auth.uid == $uid && !data.exists()))",
          ".validate": "newData.isNumber()"
        },
        "rewardBalance": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() == true",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "rewardHistory": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
        },
        "$field": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() == true || (auth.uid == $uid && $field != 'role' && $field != 'phone' && $field != 'approved' && $field != 'status' && $field != 'createdAt' && $field != 'rewardBalance' && $field != 'rewardHistory'))"
        }
      }
    },
    "appData": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() == true",
      ".write": false,
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)",
        ".write": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)"
      }
    },
    "coupons": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() == true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() == true",
      "$code": {
        ".validate": "newData.hasChildren(['code','batch','reward','status','createdAt']) && newData.child('code').val() == $code && newData.child('reward').isNumber() && newData.child('reward').val() > 0 && newData.child('batch').isString() && newData.child('createdAt').isNumber() && (newData.child('status').val() == 'Unused' || newData.child('status').val() == 'Claimed')"
      }
    }
  }
}