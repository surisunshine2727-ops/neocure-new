rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /dealerPaymentProofs/{dealerUid}/{fileName} {
      // Dealers can read their own proof files. Admins use the tokenized download URL
      // saved with the payment record; do not expose the entire bucket to all users.
      allow read: if request.auth != null && request.auth.uid == dealerUid;
      allow write: if request.auth != null
        && request.auth.uid == dealerUid
        && request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == dealerUid;
    }
  }
}
